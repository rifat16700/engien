<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Telegram Clone: Ultra-Granular Blueprint</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;600;700&family=Fira+Code:wght@400;500&display=swap');
        
        :root {
            --bg-deep: #0f172a;
            --bg-card: #1e293b;
            --accent-cyan: #22d3ee;
            --accent-lime: #bef264;
            --text-dim: #94a3b8;
        }

        body {
            font-family: 'Hind Siliguri', sans-serif;
            background-color: var(--bg-deep);
            color: #e2e8f0;
            overflow-x: hidden;
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .method-tag {
            font-family: 'Fira Code', monospace;
            font-size: 0.75rem;
            background: rgba(34, 211, 238, 0.1);
            color: var(--accent-cyan);
            padding: 2px 6px;
            border-radius: 4px;
        }

        .scroll-hide::-webkit-scrollbar { display: none; }
        
        .sticky-nav {
            position: sticky;
            top: 0;
            z-index: 50;
        }

        .indent-1 { margin-left: 1.5rem; border-left: 2px solid #334155; padding-left: 1rem; }
        .indent-2 { margin-left: 3rem; border-left: 2px solid #475569; padding-left: 1rem; }
        
        .status-dot {
            height: 8px;
            width: 8px;
            border-radius: 50%;
            display: inline-block;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 300px;
            max-height: 400px;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen">

    <!-- Left Sidebar: The Component Tree -->
    <aside class="w-full md:w-80 glass-panel p-6 overflow-y-auto h-screen sticky top-0 border-r border-slate-700 scroll-hide">
        <div class="mb-8">
            <h1 class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-lime-400 bg-clip-text text-transparent">
                TDLib Architect
            </h1>
            <p class="text-xs text-slate-500 uppercase tracking-widest mt-1">Granular SRS v2.0</p>
        </div>

        <nav class="space-y-4">
            <div>
                <p class="text-cyan-500 text-sm font-bold mb-2">Module 2: Main Shell</p>
                <ul class="space-y-2 text-sm">
                    <li class="hover:text-cyan-400 cursor-pointer flex items-center gap-2">
                        <span>📂</span> Global Search & Tabs
                    </li>
                    <li class="hover:text-cyan-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ Drawer: Profile & Accounts
                    </li>
                    <li class="hover:text-cyan-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ Chat List: Swipe & Badges
                    </li>
                    <li class="hover:text-cyan-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ FAB: New Actions
                    </li>
                </ul>
            </div>

            <div>
                <p class="text-lime-500 text-sm font-bold mb-2">Module 3: Chat Deep-Dive</p>
                <ul class="space-y-2 text-sm">
                    <li class="hover:text-lime-400 cursor-pointer flex items-center gap-2">
                        <span>💬</span> Chat Header & Status
                    </li>
                    <li class="hover:text-lime-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ Input Bar: Attachment Menu
                    </li>
                    <li class="hover:text-lime-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ Message: Actions & Reactions
                    </li>
                    <li class="hover:text-lime-400 cursor-pointer flex items-center gap-2 ml-4 text-slate-400">
                        ↳ Voice/Video Note Logic
                    </li>
                </ul>
            </div>
        </nav>

        <div class="mt-12 p-4 rounded-xl bg-slate-800/50 border border-slate-700">
            <p class="text-xs text-slate-400 leading-relaxed italic">
                "এই ডকুমেন্টটি বাটন-বাই-বাটন রিসার্চ কভার করে। প্রতিটি ক্লিকের পেছনে থাকা লজিক এখানে বর্ণিত।"
            </p>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 md:p-12 overflow-y-auto">
        
        <!-- SECTION 1: GLOBAL DASHBOARD -->
        <section id="module-2-deep" class="mb-20">
            <div class="flex items-center gap-4 mb-6">
                <div class="p-3 bg-cyan-500/20 rounded-2xl text-cyan-400">
                    <span class="text-2xl">📱</span>
                </div>
                <div>
                    <h2 class="text-3xl font-bold">Module 2: Main Dashboard (The Shell)</h2>
                    <p class="text-slate-400">অ্যাপের প্রধান ইন্টারফেস এবং নেভিগেশন স্ট্রাকচার।</p>
                </div>
            </div>

            <!-- COMPONENT: THE DRAWER -->
            <div class="bg-slate-800/40 rounded-3xl p-6 border border-slate-700 mb-10">
                <h3 class="text-xl font-bold text-cyan-400 mb-4 flex items-center gap-2">
                    2.1 The Side Drawer (Hamburger Menu)
                </h3>
                
                <div class="space-y-8">
                    <!-- Drawer Header -->
                    <div class="indent-1">
                        <h4 class="font-bold text-white mb-2">A. Drawer Header (User Context)</h4>
                        <ul class="space-y-3">
                            <li class="bg-slate-900/50 p-4 rounded-xl">
                                <span class="text-lime-400 font-bold">UI Vision:</span> ইউজার এভাটার (বামে), তার নিচে নাম এবং ফোন নাম্বার। ডান কোণায় একটি 'Down Arrow' (Account Switcher) এবং 'Moon/Sun' আইকন (Theme Toggle)।
                                <div class="mt-2 text-sm text-slate-400 italic">ইন্টারঅ্যাকশন: এভাটারে ক্লিক করলে প্রোফাইল সেটিংস ওপেন হবে। এরো-তে ক্লিক করলে নিচের দিকে অতিরিক্ত অ্যাকাউন্ট যোগ করার অপশন আসবে।</div>
                                <div class="mt-2"><span class="method-tag">td_send(getMe, {})</span> <span class="method-tag">updateUser</span></div>
                            </li>
                        </ul>
                    </div>

                    <!-- Drawer List Items -->
                    <div class="indent-1">
                        <h4 class="font-bold text-white mb-2">B. Navigation List (Point-to-Point)</h4>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="p-4 border border-slate-700 rounded-xl bg-slate-800/60">
                                <p class="font-bold text-cyan-300">1. New Group</p>
                                <p class="text-xs text-slate-400">ক্লিক করলে কন্টাক্ট লিস্ট ওপেন হবে (Multi-select)।</p>
                                <p class="text-[10px] text-lime-500 mt-2">Method: createNewBasicGroupChat</p>
                            </div>
                            <div class="p-4 border border-slate-700 rounded-xl bg-slate-800/60">
                                <p class="font-bold text-cyan-300">2. Contacts</p>
                                <p class="text-xs text-slate-400">ডিভাইস কন্টাক্ট এবং টেলিগ্রাম কন্টাক্ট সিঙ্কড লিস্ট।</p>
                                <p class="text-[10px] text-lime-500 mt-2">Method: getContacts / searchContacts</p>
                            </div>
                            <div class="p-4 border border-slate-700 rounded-xl bg-slate-800/60">
                                <p class="font-bold text-cyan-300">3. Saved Messages</p>
                                <p class="text-xs text-slate-400">নিজের সাথে চ্যাট উইন্ডো। এটি মূলত ইউজারের 'Cloud Storage'।</p>
                                <p class="text-[10px] text-lime-500 mt-2">Method: openChat(my_user_id)</p>
                            </div>
                            <div class="p-4 border border-slate-700 rounded-xl bg-slate-800/60">
                                <p class="font-bold text-cyan-300">4. Settings</p>
                                <p class="text-xs text-slate-400">অ্যাপের কনফিগারেশন প্যানেল।</p>
                                <p class="text-[10px] text-lime-500 mt-2">Transition: Push to Module 5</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- COMPONENT: CHAT LIST ITEM -->
            <div class="bg-slate-800/40 rounded-3xl p-6 border border-slate-700">
                <h3 class="text-xl font-bold text-cyan-400 mb-4 flex items-center gap-2">
                    2.2 Chat List & Swipe Logic
                </h3>
                <p class="text-sm text-slate-400 mb-6">চ্যাট লিস্টের প্রতিটি রো (Row) কিভাবে কাজ করবে তার গ্র্যানুলার ডিটেইলস:</p>
                
                <div class="space-y-4">
                    <div class="bg-slate-900 p-4 rounded-2xl border-l-4 border-cyan-500">
                        <h4 class="font-bold mb-2">Micro-Elements within a Chat Row:</h4>
                        <ul class="list-disc ml-5 text-sm space-y-2 text-slate-300">
                            <li><span class="text-white font-bold">Avatar:</span> লোড হবে <code>getFile</code> দিয়ে। ইউজারের অনলাইন স্ট্যাটাস থাকলে এভাটারে ছোট সবুজ ডট থাকবে।</li>
                            <li><span class="text-white font-bold">Read Receipt:</span> মেসেজ ডেলিভারড হলে 'Single Tick', রিড করলে 'Double Tick'। এটি <code>updateChatLastMessage</code> এবং <code>updateChatReadInbox</code> এর মাধ্যমে আপডেট হয়।</li>
                            <li><span class="text-white font-bold">Typing Indicator:</span> কেউ টাইপ করলে নামের নিচে "Typing..." এনিমেশন আসবে। <br><span class="method-tag">UpdateUserTyping</span></li>
                            <li><span class="text-white font-bold">Unread Badge:</span> ডান পাশে নীল/ধূসর সার্কেল। কাউন্ট আসবে <code>unread_count</code> থেকে।</li>
                        </ul>
                    </div>

                    <div class="bg-slate-900 p-4 rounded-2xl border-l-4 border-lime-500">
                        <h4 class="font-bold mb-2">Swipe Actions (Left/Right):</h4>
                        <div class="flex gap-2 mt-2">
                            <span class="px-3 py-1 bg-blue-600 rounded-full text-xs">Pin (Right Swipe)</span>
                            <span class="px-3 py-1 bg-yellow-600 rounded-full text-xs">Mute</span>
                            <span class="px-3 py-1 bg-red-600 rounded-full text-xs">Delete (Left Swipe)</span>
                            <span class="px-3 py-1 bg-gray-600 rounded-full text-xs">Archive</span>
                        </div>
                        <p class="text-xs text-slate-500 mt-3 italic">লজিক: Pin করলে <code>toggleChatIsPinned</code> কল হবে।</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: CHAT INTERFACE -->
        <section id="module-3-deep" class="mb-20">
            <div class="flex items-center gap-4 mb-6">
                <div class="p-3 bg-lime-500/20 rounded-2xl text-lime-400">
                    <span class="text-2xl">💬</span>
                </div>
                <div>
                    <h2 class="text-3xl font-bold">Module 3: Chat Interface (The Core)</h2>
                    <p class="text-slate-400">মেসেজিংয়ের প্রতিটি খুটিনাটি লজিক এখানে বর্ণিত।</p>
                </div>
            </div>

            <!-- COMPONENT: ATTACHMENT MENU -->
            <div class="bg-slate-800/40 rounded-3xl p-6 border border-slate-700 mb-10">
                <h3 class="text-xl font-bold text-lime-400 mb-4">3.1 Attachment Menu (The Grid)</h3>
                <p class="text-sm text-slate-300 mb-4">ইনপুট ফিল্ডের 'Paperclip' আইকনে ক্লিক করলে নিচের দিক থেকে একটি প্যানেল স্লাইড করে আসবে।</p>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-slate-900/80 p-4 rounded-2xl">
                        <p class="text-cyan-400 font-bold mb-2 underline">Gallery</p>
                        <p class="text-xs text-slate-400 leading-relaxed">ডিভাইসের সব ছবি/ভিডিও গ্রিড আকারে দেখাবে। মাল্টি-সিলেক্ট এবং ক্যাপশন অপশন থাকবে।</p>
                        <p class="text-[10px] text-white/50 mt-2 italic">Logic: sendMessage with inputMessagePhoto</p>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-2xl">
                        <p class="text-cyan-400 font-bold mb-2 underline">Poll / Quiz</p>
                        <p class="text-xs text-slate-400 leading-relaxed">একটি ডায়ালগ ওপেন হবে যেখানে Question এবং Options ইনপুট নেওয়া হবে।</p>
                        <p class="text-[10px] text-white/50 mt-2 italic">Logic: inputMessagePoll</p>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-2xl">
                        <p class="text-cyan-400 font-bold mb-2 underline">Location</p>
                        <p class="text-xs text-slate-400 leading-relaxed">Live Location (Real-time update) অথবা Static Location পাঠানোর অপশন।</p>
                        <p class="text-[10px] text-white/50 mt-2 italic">Logic: inputMessageLocation</p>
                    </div>
                </div>
            </div>

            <!-- COMPONENT: VOICE/VIDEO NOTES -->
            <div class="bg-slate-800/40 rounded-3xl p-6 border border-slate-700">
                <h3 class="text-xl font-bold text-lime-400 mb-4">3.2 Voice & Video Note Interaction</h3>
                <div class="space-y-4">
                    <div class="indent-1">
                        <p class="font-bold text-white">Voice Note Logic (Hold & Swipe):</p>
                        <ul class="text-sm text-slate-400 space-y-2 mt-2">
                            <li><span class="text-cyan-400">Step 1 (Press):</span> ইনপুট ফিল্ডের মাইক্রোফোন বাটনে লং-প্রেস করলে রেকর্ডিং শুরু হবে।</li>
                            <li><span class="text-cyan-400">Step 2 (Slide Up):</span> স্লাইড আপ করলে রেকর্ডিং 'Lock' হবে (Hands-free mode)।</li>
                            <li><span class="text-cyan-400">Step 3 (Slide Left):</span> স্লাইড লেফট করলে রেকর্ডিং 'Cancel/Trash' হবে।</li>
                        </ul>
                        <div class="mt-4 p-3 bg-black/40 rounded-lg">
                            <p class="text-[11px] text-lime-500 font-mono">TDLib Call: td_send(sendMessage, { content: inputMessageVoiceNote })</p>
                        </div>
                    </div>
                    
                    <!-- Chart for Message Flow -->
                    <div class="mt-8">
                        <p class="text-center text-xs text-slate-500 mb-4 font-bold uppercase">Message Delivery Lifecycle</p>
                        <div class="chart-container">
                            <canvas id="msgFlowChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FOOTER / NEXT STEPS -->
        <footer class="mt-20 border-t border-slate-800 pt-10 text-center">
            <p class="text-slate-500 text-sm">এটি মডিউল ২ এবং ৩ এর বিস্তারিত রিসার্চ।</p>
            <button class="mt-4 px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-full font-bold hover:scale-105 transition active:scale-95 shadow-lg shadow-cyan-500/20">
                Continue to Module 4: Groups & Channels →
            </button>
        </footer>
    </main>

    <script>
        // Message Flow Chart Implementation
        const ctx = document.getElementById('msgFlowChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Input', 'Local DB', 'Server Sent', 'Delivered', 'Read'],
                datasets: [{
                    label: 'Latency (ms)',
                    data: [10, 45, 120, 300, 800],
                    borderColor: '#22d3ee',
                    backgroundColor: 'rgba(34, 211, 238, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointBackgroundColor: '#bef264'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { grid: { color: '#334155' }, ticks: { color: '#94a3b8' } },
                    x: { grid: { display: false }, ticks: { color: '#94a3b8' } }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // Smooth Scrolling logic
        document.querySelectorAll('li.cursor-pointer').forEach(item => {
            item.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        });
    </script>
</body>
</html>